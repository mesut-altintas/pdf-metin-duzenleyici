# Oturum çerezini imzalayan anahtar. Vercel'de zorunlu (yoksa uygulama açılmaz).
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Kullanıcılar: ad=özet, virgülle ayrılır. Özet: python sifre_ozeti.py <ad>
KULLANICILAR=

# Yerelde https olmadan çerez gönderilsin diye boş bırakın; Vercel'de kendiliğinden güvenli.
# GUVENLI_CEREZ=1

# Kullanıcı deposu (Neon Postgres). Boşsa yalnız KULLANICILAR girer, yönetim sayfası okur-yazmaz.
# Yerelde: host=127.0.0.1 port=54331 user=test dbname=pdf_yerel
DATABASE_URL=

# Aylık belge kotasını kapatır (1 = kapalı; sayılmaz, ekranda sayaç çizilmez). docs/plan-kota.md
# KOTA_KAPALI=1

# E-posta (Resend). Üçü de doluysa şifremi unuttum açık. docs/kayit.md
# RESEND_API_KEY=
# EPOSTA_GONDEREN=PDF Metin Düzenleyici <pdf@altintas.biz>
# UYGULAMA_ADRESI=https://pdf.altintas.biz
# Kayıt sayfasını açar (e-posta da tanımlı olmalı).
# KAYIT_ACIK=1
